# If this is the top-level multilib, build all the other
# multilibs.
# Early copyback; see "all" above for the rationale.  The
# early copy is necessary so that the gcc -B options find
dest=../.././gcc/include/tmp$$-unwind.h; \
cp unwind.h $dest; \
chmod a+r $dest; \
sh ../../../libgcc/../move-if-change $dest ../.././gcc/include/unwind.h
# the right startup files when linking shared libgcc.
/bin/bash ../../../libgcc/../mkinstalldirs ../.././gcc
parts="crtbegin.o crtbeginS.o crtbeginT.o crtend.o crtendS.o crtprec32.o crtprec64.o crtprec80.o crtfastmath.o";					\
for file in $parts; do					\
  rm -f ../.././gcc/$file;		\
  /usr/bin/install -c -m 644 $file ../.././gcc/;	\
  case $file in 					\
    *.a)						\
      /mnt/lfs/tools/lib/gcc/x86_64-lfs-linux-gnu/16.2.0/../../../../x86_64-lfs-linux-gnu/bin/ranlib --plugin /mnt/lfs/tools/libexec/gcc/x86_64-lfs-linux-gnu/16.2.0/liblto_plugin.so ../.././gcc/$file ;;	\
  esac;							\
done
